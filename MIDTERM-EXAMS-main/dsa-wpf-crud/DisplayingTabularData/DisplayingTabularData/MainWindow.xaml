<Window x:Class="DisplayingTabularData.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DisplayingTabularData"
        mc:Ignorable="d"
        Title="MainWindow" Height="520" Width="820">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="93*"/>
            <ColumnDefinition Width="107*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>



        <DataGrid x:Name="ProductsDataGrid"
                  Grid.Row="1"
                  ItemsSource="{Binding Products}"
                  AutoGenerateColumns="False"
                  SelectionMode="Single"
                  CanUserAddRows="False"
                  Margin="0,50,409,134" SelectionChanged="ProductsDataGrid_SelectionChanged" Grid.ColumnSpan="2"
                 >
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="30"/>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="65"/>
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                <DataGridTextColumn Header="Price" Binding="{Binding Price}" Width="*"/>

            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="1" BorderThickness="1" CornerRadius="4" Padding="8" BorderBrush="#DDD" Margin="-10,388,-10,0" Grid.ColumnSpan="2">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,1,0,0" Width="780" >
                <StackPanel Orientation="Vertical" Margin="0,0,12,0">
                    <TextBlock Text="ID" />
                    <TextBox x:Name="IdTextBox" Width="30" />
                </StackPanel>

                <StackPanel Orientation="Vertical" Margin="0,0,12,0">
                    <TextBlock Text="Name" />
                    <TextBox x:Name="NameTextBox" Width="80"/>
                </StackPanel>

                <StackPanel Orientation="Vertical" Margin="0,0,12,0">
                    <TextBlock Text="Description" />
                    <TextBox x:Name="DescriptionTextBox" Width="120"/>
                </StackPanel>

                <StackPanel Orientation="Vertical" Margin="0,0,12,0">
                    <TextBlock Text="Price" />
                    <TextBox x:Name="PriceTextBox" Width="100"/>
                </StackPanel>


                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="8,0,0,0">
                    <Button Content="Add Item" Width="90" Margin="4,0" Click="AddButton_Click" RenderTransformOrigin="0.4,-0.679"/>
                    <Button Content="Remove Item" Width="90" Margin="4,0" Click="RemoveButton_Click"/>
                    <Button Content="Add to Cart" Width="90" Margin="4,0" Click="AddToCartButton_Click"/>
                    <Button Content="Clear" Width="90" Margin="4,0" Click="ClearButton_Click"/>

                </StackPanel>
            </StackPanel>
        </Border>
        <DataGrid x:Name="ShoppingCartDataGrid"
            Grid.Row="1"
            ItemsSource="{Binding ShoppingCart}"
            AutoGenerateColumns="False"
            SelectionMode="Single"
            CanUserAddRows="False"
            Margin="28,50,0,135" SelectionChanged="ShoppingCartDataGrid_SelectionChanged" Grid.Column="1"
                 >
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="30"/>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="65"/>
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                <DataGridTextColumn Header="Price" Binding="{Binding Price}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock HorizontalAlignment="Center" Height="29" Margin="0,354,0,0" Grid.RowSpan="2" TextWrapping="Wrap" Text="Available Items" VerticalAlignment="Top" Width="122" FontSize="18"/>
        <TextBlock HorizontalAlignment="Center" Height="29" Margin="0,354,0,0" Grid.RowSpan="2" TextWrapping="Wrap" Text="Shopping Cart" VerticalAlignment="Top" Width="122" FontSize="18" Grid.Column="1"/>
    </Grid>
</Window>
